            b.classList.add("bg-slate-900", "text-slate-300");
          });
          btn.classList.add("tab-active");
          btn.classList.remove("bg-slate-900", "text-slate-300");

          document.querySelectorAll(".tab-panel").forEach(p => p.classList.add("hidden"));
          document.getElementById("panel-" + target).classList.remove("hidden");

          if (target === "drawdowns") initCharts(false);
          if (target === "macro") initMacroChart();
        });
      });

      document.getElementById("filter-dip-all").addEventListener("click", () => initCharts(false));
      document.getElementById("filter-dip-3to5").addEventListener("click", () => initCharts(true));

      document.getElementById("custom-asset-form").addEventListener("submit", e => {
        e.preventDefault();
        const newItem = {
          name: document.getElementById("inp-name").value.trim(),
          type: document.getElementById("inp-type").value,
          price: parseFloat(document.getElementById("inp-price").value) || 100,
          high52: parseFloat(document.getElementById("inp-high52").value) || 130,
          low52: parseFloat(document.getElementById("inp-low52").value) || 80,
          d1: parseFloat(document.getElementById("inp-1d").value) || 0,
          m1: parseFloat(document.getElementById("inp-1m").value) || 0,
          m3: parseFloat(document.getElementById("inp-3m").value) || 0,
          m6: parseFloat(document.getElementById("inp-6m").value) || 0,
          y1: parseFloat(document.getElementById("inp-1y").value) || 0,
          pe: parseFloat(document.getElementById("inp-pe").value) || 20,
          roce: parseFloat(document.getElementById("inp-roce").value) || 15,
          de: parseFloat(document.getElementById("inp-de").value) || 0.2,
          inst: document.getElementById("inp-inst").value,
          notes: document.getElementById("inp-notes").value.trim()
        };
        customAssets.unshift(newItem);
        saveCustomAssets();
        renderCustomWatchlist();
        document.getElementById("inp-name").value = "";
        document.getElementById("inp-notes").value = "";
      });

      document.getElementById("btn-reset-custom").addEventListener("click", () => {
        customAssets = JSON.parse(JSON.stringify(DEFAULT_CUSTOM_ASSETS));
        saveCustomAssets();
        renderCustomWatchlist();
      });

      document.getElementById("btn-export-csv").addEventListener("click", () => {
        const rows = [["Candidate_Name_ISIN", "Category", "Price", "52W_High", "52W_Low", "1D_Pct", "1M_Pct", "3M_Pct", "6M_Pct", "12M_Pct", "PE_or_TER", "ROCE_Pct", "DE_or_Pledge", "Governance_Status", "Gatekeeper_Score", "Classification"]];
        customAssets.forEach(a => {
          const q = computeQuantAnalysis(a);
          rows.push([`"${a.name}"`, `"${a.type}"`, a.price, a.high52, a.low52, a.d1, a.m1, a.m3, a.m6, a.y1, a.pe, a.roce, a.de, a.inst, q.score, `"${q.signal}"`]);
        });
        const csv = rows.map(r => r.join(",")).join("\n");
        const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "alphavault_gatekeeper_register_oct2026.csv";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    });
  </script>
</body>
</html>