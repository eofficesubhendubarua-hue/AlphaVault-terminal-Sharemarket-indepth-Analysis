    function normCDF(x) {
      const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
      const sign = x < 0 ? -1 : 1;
      const absX = Math.abs(x) / Math.sqrt(2.0);
      const t = 1.0 / (1.0 + p * absX);
      const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-absX * absX);
      return 0.5 * (1.0 + sign * y);
    }

    function normPDF(x) {
      return Math.exp(-0.5 * x * x) / Math.sqrt(2.0 * Math.PI);
    }

    function computeBSMGreeks() {
      const S = parseFloat(document.getElementById("bsm-spot").value) || 22600;
      const K = parseFloat(document.getElementById("bsm-strike").value) || 22600;
      const iv = (parseFloat(document.getElementById("bsm-vol").value) || 15.81) / 100.0;
      const days = Math.max(1, parseFloat(document.getElementById("bsm-days").value) || 4);
      const T = days / 365.0;
      const r = 0.0675;

      const d1 = (Math.log(S / K) + (r + 0.5 * iv * iv) * T) / (iv * Math.sqrt(T));
      const d2 = d1 - iv * Math.sqrt(T);

      const callPrice = S * normCDF(d1) - K * Math.exp(-r * T) * normCDF(d2);
      const putPrice = K * Math.exp(-r * T) * normCDF(-d2) - S * normCDF(-d1);
      const straddle = callPrice + putPrice;

      const callDelta = normCDF(d1);
      const putDelta = callDelta - 1.0;
      const gamma = normPDF(d1) / (S * iv * Math.sqrt(T));
      const vega = (S * normPDF(d1) * Math.sqrt(T)) / 100.0;
      const callTheta = (-(S * normPDF(d1) * iv) / (2 * Math.sqrt(T)) - r * K * Math.exp(-r * T) * normCDF(d2)) / 365.0;

      const move1D = S * (iv / Math.sqrt(252));
      const moveExp = S * iv * Math.sqrt(T);

      const el = document.getElementById("bsm-results");
      if (!el) return;
      el.innerHTML = `
        <div class="p-2.5 rounded bg-slate-900 border border-slate-800">
          <div class="text-[10px] text-slate-400">ATM Straddle (C+P)</div>
          <div class="text-sm font-bold text-white">${straddle.toFixed(1)} pts</div>
          <div class="text-[10px] text-slate-400">C: ${callPrice.toFixed(1)} | P: ${putPrice.toFixed(1)}</div>
        </div>
        <div class="p-2.5 rounded bg-slate-900 border border-slate-800">
          <div class="text-[10px] text-slate-400">Call / Put Delta (Δ)</div>
          <div class="text-sm font-bold text-emerald-400">+${callDelta.toFixed(2)} / ${putDelta.toFixed(2)}</div>
          <div class="text-[10px] text-slate-400">Directional Sensitivity</div>
        </div>
        <div class="p-2.5 rounded bg-slate-900 border border-slate-800">
          <div class="text-[10px] text-slate-400">Gamma (Γ) per Pt</div>
          <div class="text-sm font-bold text-amber-400">${gamma.toFixed(4)}</div>
          <div class="text-[10px] text-slate-400">Delta Acceleration</div>
        </div>
        <div class="p-2.5 rounded bg-slate-900 border border-slate-800">
          <div class="text-[10px] text-slate-400">Daily Theta (Θ) / Vega (ν)</div>
          <div class="text-sm font-bold text-rose-400">${callTheta.toFixed(1)} / +${vega.toFixed(1)}</div>
          <div class="text-[10px] text-slate-400">Time Decay vs IV Shift</div>
        </div>
        <div class="p-2.5 rounded bg-slate-900 border border-slate-800">
          <div class="text-[10px] text-slate-400">1-Day 1SD Range</div>
          <div class="text-sm font-bold text-blue-300">±${move1D.toFixed(0)} pts</div>
          <div class="text-[10px] text-slate-400">${(S - move1D).toFixed(0)} – ${(S + move1D).toFixed(0)}</div>
        </div>
        <div class="p-2.5 rounded bg-slate-900 border border-slate-800">
          <div class="text-[10px] text-slate-400">${days}D Expiry 1SD Range</div>
          <div class="text-sm font-bold text-purple-300">±${moveExp.toFixed(0)} pts</div>
          <div class="text-[10px] text-slate-400">${(S - moveExp).toFixed(0)} – ${(S + moveExp).toFixed(0)}</div>
        </div>
      `;
    }

